{
  "name": "extrapotions-dropper",
  "private": true,
  "version": "3.4.27",
  "description": "Twitch Drops companion userscript",
  "scripts": {
    "build": "node scripts/assemble-parts.cjs && node scripts/minify-dist.cjs",
    "test": "npm run build && node --test tests/*.test.cjs",
    "minify": "npm run build",
    "screenshots": "node ../exp-core/scripts/capture-screenshots.cjs Dropper",
    "watch": "node scripts/watch-dropper.cjs",
    "watch:once": "node scripts/watch-dropper.cjs --once",
    "watch:import-auth": "node scripts/watch-import-auth.cjs",
    "prepare:release:feature": "node scripts/prepare-feature-release.cjs && npm run build",
    "prepare:release:core": "node scripts/prepare-core-release.cjs",
    "test:installed-browser": "node scripts/test-installed-browser.cjs",
    "build:check": "node scripts/assemble-parts.cjs --check"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "terser": "5.51.2"
  }
}
